# NoteOcean Environment Variables
# The Backboard API key is stored server-side only and never sent to the browser.
# Get your key from https://app.backboard.io
BACKBOARD_API_KEY=

# Optional AI Configuration:
# BACKBOARD_ASSISTANT_ID=
# BACKBOARD_MODEL=google/gemma-3-27b-it
# BACKBOARD_PROVIDER=openrouter
